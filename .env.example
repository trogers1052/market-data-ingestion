# Alpaca API (free IEX feed — real-time, no delay). Both keys are required.
ALPACA_API_KEY_ID=your_alpaca_api_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_api_secret_key_here

# Database (TimescaleDB / PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=trader
DB_PASSWORD=your_password_here
DB_NAME=market_data
DB_SSL_MODE=disable

# Kafka / Redpanda (publishes ingested quotes to other services)
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:19092
KAFKA_QUOTES_TOPIC=stock.quotes.realtime

# Kafka watchlist consumer (syncs monitored symbols from trading.watchlist)
WATCHLIST_SYNC_ENABLED=true
KAFKA_WATCHLIST_TOPIC=trading.watchlist
KAFKA_CONSUMER_GROUP=market-data-ingestion

# Redis (reads the shared watchlist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Ingestion settings
POLL_INTERVAL_SECONDS=60
BACKFILL_MONTHS=60
# Days to exclude from REST backfill (0 = include today; Alpaca IEX is real-time)
BACKFILL_DELAY_DAYS=0
# How far behind real-time to poll, in minutes (0 = real-time)
POLLING_DELAY_MINUTES=0

# Market Hours (Eastern Time)
# Regular market: 9:30am-4pm (use 9 and 16)
# Extended hours: 4am-8pm (use 4 and 20)
MARKET_OPEN_HOUR=4
MARKET_CLOSE_HOUR=20
ENABLE_PRE_MARKET=true
ENABLE_AFTER_HOURS=true
