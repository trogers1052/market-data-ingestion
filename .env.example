# Polygon.io API
POLYGON_API_KEY=your_polygon_api_key_here

# TimescaleDB Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=trader
DB_PASSWORD=your_password_here
DB_NAME=market_data
DB_SSL_MODE=disable

# Kafka/Redpanda (optional - for publishing to other services)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:19092
KAFKA_OHLCV_TOPIC=market.ohlcv.1min

# Ingestion Configuration
POLL_INTERVAL_SECONDS=60
BACKFILL_MONTHS=6

# Market Hours (Eastern Time)
# Regular market: 9:30am-4pm (use 9 and 16)
# Extended hours: 4am-8pm (use 4 and 20)
MARKET_OPEN_HOUR=4
MARKET_CLOSE_HOUR=20
ENABLE_PRE_MARKET=true
ENABLE_AFTER_HOURS=true
